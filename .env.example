# Application
NODE_ENV=development
APP_NAME=perdiem-management-system
APP_VERSION=1.0.0
APP_PORT=3001
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3002

# Database
MONGODB_URI=mongodb://localhost:27017/perdiem

# JWT (Phase 1 - placeholder)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Rate limiting (Phase 9)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Email (invites) — console logs in dev; set smtp for production
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@perdiem.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Redis (optional) — enables async domain event queue for notifications
REDIS_URL=redis://localhost:6379

# Google OAuth SSO (optional)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Microsoft Azure AD OAuth (optional)
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_DIRECTORY_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/v1/auth/microsoft/callback

# SAML SSO (optional) — enterprise IdP (Okta, Azure AD SAML, etc.)
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=http://localhost:3001/api/v1/auth/saml/metadata
SAML_IDP_CERT=
SAML_CALLBACK_URL=http://localhost:3001/api/v1/auth/saml/callback

# Observability (optional)
SENTRY_DSN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SENTRY_DSN=
